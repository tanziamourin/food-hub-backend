generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  role            Role             @default(CUSTOMER)
  status          UserStatus       @default(ACTIVE)
  emailVerified   Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  image           String?
  phone           String?
  orders          Order[]
  providerProfile ProviderProfile?
  reviews         Review[]
  accounts        Account[]
  sessions        Session[]

  @@map("user")
}


model ProviderProfile {
  id          String @id @default(uuid())
  userId      String @unique

  shopName    String?
  address     String?
  phone       String?
  logo        String?
  description String?

  meals Meal[]

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  meals Meal[]
}

model Meal {
  id          String          @id @default(uuid())
  name        String
  description String
  price       Float
  providerId  String
  categoryId  String
  image       String?
  category    Category        @relation(fields: [categoryId], references: [id])
  provider    ProviderProfile @relation(fields: [providerId], references: [id])
  orderItems  OrderItem[]
  reviews     Review[]
}

model Order {
  id              String      @id @default(uuid())
  customerId      String
  status          OrderStatus @default(PLACED)
  createdAt       DateTime    @default(now())
  deliveryAddress String

  
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  totalAmount     Float

  customer        User        @relation(fields: [customerId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  mealId   String
  quantity Int
  price    Float
  meal     Meal   @relation(fields: [mealId], references: [id])
  order    Order  @relation(fields: [orderId], references: [id])

  @@unique([orderId, mealId])
}

model Review {
  id      String @id @default(uuid())
  rating  Int
  comment String
  mealId  String
  userId  String
  meal    Meal   @relation(fields: [mealId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([userId, mealId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
enum UserStatus {
  ACTIVE
  SUSPENDED
}
